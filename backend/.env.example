# Use the Paystack TEST secret key first (starts with sk_test_).
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_TEST_SECRET

# Exact public HTTPS URL where the shop website is hosted, no trailing slash.
FRONTEND_URL=https://your-shop-domain.example

# Public HTTPS URL of this backend, no trailing slash.
BACKEND_PUBLIC_URL=https://your-backend-domain.example

# Comma-separated allowed frontend origins. Include localhost during local testing if needed.
ALLOWED_ORIGINS=https://your-shop-domain.example

# Firebase service account JSON as one-line JSON string, set in hosting environment variables.
FIREBASE_SERVICE_ACCOUNT_JSON={}
